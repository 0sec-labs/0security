# syntax=docker/dockerfile:1.7
#
# 0-kali — Pre-built Kali Linux image for benchmark / Docker executor mode.
#
# Contains a full pentesting toolset so the Docker executor can start
# immediately without pulling packages at runtime.
#
# Build:
#   docker build -f packages/engine/docker/Dockerfile.kali -t ghcr.io/0sec-labs/0-kali:latest .
#
# Run (manual):
#   docker run --rm -it ghcr.io/0sec-labs/0-kali:latest bash

FROM rust:1.93-bookworm@sha256:7c4ae649a84014c467d79319bbf17ce2632ae8b8be123ac2fb2ea5be46823f31 AS foxguard-builder
# Foxguard is built from this repository (crates/foxguard), not downloaded. The
# toolchain comes from rust-toolchain.toml through scripts/ensure-rust.sh, so the
# image, CI and the release binaries use the same compiler.
ENV CARGO_BUILD_JOBS=2
WORKDIR /build
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY scripts/ensure-rust.sh scripts/ensure-rust.sh
RUN bash scripts/ensure-rust.sh
COPY crates/foxguard crates/foxguard
RUN cargo build --locked --release -p foxguard --bin foxguard \
    && install -D -m 0755 target/release/foxguard /out/foxguard

FROM kalilinux/kali-rolling

ARG DEBIAN_FRONTEND=noninteractive

# Install all pentesting tools and utilities in a single layer to minimise
# image size.  Apt lists and pip cache are cleaned up at the end.
# Kali rolling no longer carries gh; use GitHub's signed official repository.
# Pwntools' Unicorn dependency needs a native build on arm64.
# Wfuzz imports pkg_resources but does not declare its runtime dependency.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        nmap \
        sqlmap \
        wpscan \
        nikto \
        gobuster \
        ffuf \
        hydra \
        john \
        dirb \
        wfuzz \
        curl \
        wget \
        python3 \
        python3-pip \
        python3-pkg-resources \
        build-essential \
        cmake \
        pkg-config \
        netcat-openbsd \
        socat \
        proxychains4 \
        seclists \
        whatweb \
        git \
        jq \
        ca-certificates \
        gdb \
        gdb-multiarch \
        radare2 \
        binwalk \
        foremost \
        libimage-exiftool-perl \
        ltrace \
        strace \
        file \
        binutils \
        python3-ropgadget \
    && mkdir -p /etc/apt/keyrings \
    && curl --fail --location --silent --show-error \
        https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && printf '%s\n' \
        '6084d5d7bd8e288441e0e94fc6275570895da18e6751f70f057485dc2d1a811b  /etc/apt/keyrings/githubcli-archive-keyring.gpg' \
        | sha256sum -c - \
    && printf 'deb [arch=%s signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' \
        "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends gh \
    && pip3 install --no-cache-dir --break-system-packages \
        requests \
        pwntools \
        beautifulsoup4 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Foxguard is built from crates/foxguard, as in the CLI image.
COPY --from=foxguard-builder /out/foxguard /usr/local/bin/foxguard

# Create a non-root user for running pentesting commands
RUN useradd -m -s /bin/bash pentester \
    && mkdir -p /shared /work \
    && chown pentester:pentester /shared /work

USER pentester
WORKDIR /work

CMD ["bash"]
