						"primaryLocationLineHash": "c99951d53455e82ba8d74c63d6540915"
					},
					"ruleId": "local-admin-panel-exposed"
				}
			],
			"tool": {
				"driver": {
					"downloadUri": "https://github.com/projectdiscovery/nuclei/releases",
					"fullDescription": {
						"text": "Fast and customizable vulnerability scanner based on simple YAML based DSL"
					},
					"fullName": "Nuclei v3.11.1",
					"name": "Nuclei",
					"organization": "ProjectDiscovery",
					"product": "Nuclei",
					"rules": [
						{
							"fullDescription": {
								"text": "The /admin page answers without any sign-in.\nMore details at\n\n"
