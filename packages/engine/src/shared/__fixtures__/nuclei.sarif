									"endLine": 3,
									"snippet": {
										"text": "127.0.0.1"
									},
									"startLine": 1
								},
								"region": {
									"snippet": {
										"text": "127.0.0.1"
									},
									"startLine": 1
								}
							}
						}
					],
					"message": {
						"text": "Admin panel exposed without login (local-admin-panel-exposed) found on 127.0.0.1"
					},
