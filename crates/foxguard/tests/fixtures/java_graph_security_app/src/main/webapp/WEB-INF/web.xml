<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <servlet>
    <servlet-name>report</servlet-name>
    <servlet-class>com.example.shop.LegacyReportServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>report</servlet-name>
    <url-pattern>/legacy/report</url-pattern>
  </servlet-mapping>
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>legacy</web-resource-name>
      <url-pattern>/legacy/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>auditor</role-name>
    </auth-constraint>
  </security-constraint>
</web-app>
