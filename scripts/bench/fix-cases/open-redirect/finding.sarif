{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bench-sast",
          "rules": [
            {
              "id": "bench/open-redirect",
              "name": "open-redirect",
              "shortDescription": {
                "text": "Open redirect after login"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "bench/open-redirect",
          "level": "warning",
          "message": {
            "text": "Open redirect after login. Untrusted input reaches a sensitive operation here."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/login.js"
                },
                "region": {
                  "startLine": 4,
                  "endLine": 4
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
