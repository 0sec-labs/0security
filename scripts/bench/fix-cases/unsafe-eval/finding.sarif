{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bench-sast",
          "rules": [
            {
              "id": "bench/unsafe-deserialization",
              "name": "unsafe-deserialization",
              "shortDescription": {
                "text": "Unsafe eval of a pasted settings document"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "bench/unsafe-deserialization",
          "level": "error",
          "message": {
            "text": "Unsafe eval of a pasted settings document. Untrusted input reaches a sensitive operation here."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/settings.js"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
