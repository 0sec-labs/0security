{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bench-sast",
          "rules": [
            {
              "id": "bench/missing-authorization",
              "name": "missing-authorization",
              "shortDescription": {
                "text": "Missing authorization check on note read and delete"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "bench/missing-authorization",
          "level": "error",
          "message": {
            "text": "Missing authorization check on note read and delete. Untrusted input reaches a sensitive operation here."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/notes.js"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 15
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
