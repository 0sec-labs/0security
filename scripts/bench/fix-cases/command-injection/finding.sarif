{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bench-sast",
          "rules": [
            {
              "id": "bench/command-injection",
              "name": "command-injection",
              "shortDescription": {
                "text": "Command injection in countLines"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "bench/command-injection",
          "level": "error",
          "message": {
            "text": "Command injection in countLines. Untrusted input reaches a sensitive operation here."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lines.js"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 5
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
