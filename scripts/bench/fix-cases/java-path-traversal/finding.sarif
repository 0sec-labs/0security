{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bench-sast",
          "rules": [
            {
              "id": "bench/path-traversal",
              "name": "path-traversal",
              "shortDescription": {
                "text": "Path traversal in DocumentStore.read"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "bench/path-traversal",
          "level": "error",
          "message": {
            "text": "Path traversal in DocumentStore.read. Untrusted input reaches a sensitive operation here."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app/DocumentStore.java"
                },
                "region": {
                  "startLine": 16,
                  "endLine": 16
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
