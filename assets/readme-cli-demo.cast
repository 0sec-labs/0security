[0.003, "o", "Author: Demo <demo@example.com>\r\nDate:   Mon Nov 23 22:32:01 2026 -0800\r\n\r\n    fix: SQL injection in customer order lookup\r\n    \r\n    Finding 733ab749-5582-4496-8c85-d2e864bb35aa\r\n\r\n"]
[0.000, "o", "\u001b[1mdiff --git a/server.js b/server.js\u001b[m\r\n\u001b[1mindex 0111746..7020599 100644\u001b[m\r\n\u001b[1m--- a/server.js\u001b[m\r\n\u001b[1m+++ b/server.js\u001b[m\r\n\u001b[36m@@ -14,8 +14,8 @@\u001b[m \u001b[mapp.use((req, res, next) => {\u001b[m\r\n // Look up orders for a customer.\u001b[m\r\n app.get('/orders', (req, res) => {\u001b[m\r\n   const rows = db\u001b[m\r\n\u001b[31m-    .prepare(\"SELECT * FROM orders WHERE customer = '\" + req.query.customer + \"'\")\u001b[m\r\n\u001b[31m-    .all();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .prepare('SELECT * FROM orders WHERE customer = ?')\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .all(req.query.customer);\u001b[m\r\n   res.json(rows.map(formatOrder));\u001b[m\r\n });\u001b[m\r\n \u001b[m\r\n"]
